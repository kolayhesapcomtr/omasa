# Database Configuration
POSTGRES_USER=omasa
POSTGRES_PASSWORD=omasa_secure_password_change_in_production
POSTGRES_DB=omasa
DATABASE_URL=postgresql://omasa:omasa_secure_password_change_in_production@postgres:5432/omasa?schema=public

# JWT Secrets (CHANGE THESE IN PRODUCTION!)
JWT_SECRET=your_very_secure_jwt_secret_key_min_32_chars
JWT_REFRESH_SECRET=your_very_secure_refresh_secret_key_min_32_chars

# Redis (optional but recommended for production)
REDIS_URL=redis://redis:6379

# Frontend URLs
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001
CORS_ORIGIN=http://localhost:3000

# Environment
NODE_ENV=production

# Optional: Email Configuration (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Optional: File Upload Configuration
MAX_FILE_SIZE=10485760  # 10MB in bytes
UPLOAD_DIR=./uploads

# Optional: Monitoring
SENTRY_DSN=your-sentry-dsn-here
